<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/cozy_card_background"
        app:cardCornerRadius="@dimen/cat_puzzle_dialog_radius"
        app:cardElevation="8dp"
        app:strokeColor="@color/cozy_card_stroke"
        app:strokeWidth="@dimen/card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_pause_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_pause_title"
                android:textColor="@color/cozy_navy_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Resume Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/cozy_pastel_pink"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_btn_resume"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius_pill" />

            <!-- Restart Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_restart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cozy_pastel_blue"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_btn_restart"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius_pill" />

            <!-- Exit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_exit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cozy_pastel_blue_container"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_btn_quit"
                android:textAllCaps="false"
                android:textColor="@color/cozy_navy_text"
                android:textSize="15sp"
                app:cornerRadius="@dimen/button_corner_radius_pill"
                app:strokeColor="@color/cozy_card_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Peeking Cat on top -->
    <ImageView
        android:id="@+id/iv_peeking_cat"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/img_puzzle_cute_cat" />

</FrameLayout>
