<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:cardBackgroundColor="@color/cozy_card_background"
        app:cardCornerRadius="@dimen/cat_puzzle_dialog_radius"
        app:cardElevation="10dp"
        app:strokeColor="@color/cozy_card_stroke"
        app:strokeWidth="@dimen/card_stroke_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="16dp">

            <!-- Ribbon Header -->
            <TextView
                android:id="@+id/tv_complete_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_pill_selected"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp"
                android:text="@string/dialog_complete_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 3 Stars -->
            <LinearLayout
                android:id="@+id/layout_complete_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_complete_star_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_yellow" />

                <ImageView
                    android:id="@+id/iv_complete_star_2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_yellow" />

                <ImageView
                    android:id="@+id/iv_complete_star_3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_yellow" />
            </LinearLayout>

            <!-- Stats Row: 3 customizable stat slots -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_pill_unselected"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <!-- Stat 1 -->
                <LinearLayout
                    android:id="@+id/layout_stat_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_1_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/cozy_navy_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="14 moves" />

                    <TextView
                        android:id="@+id/tv_stat_1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/cozy_subtext"
                        android:textSize="11sp"
                        tools:text="Moves" />
                </LinearLayout>

                <!-- Stat 2 -->
                <LinearLayout
                    android:id="@+id/layout_stat_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_2_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/cozy_navy_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="01:23" />

                    <TextView
                        android:id="@+id/tv_stat_2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/cozy_subtext"
                        android:textSize="11sp"
                        tools:text="Time" />
                </LinearLayout>

                <!-- Stat 3 -->
                <LinearLayout
                    android:id="@+id/layout_stat_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_3_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/cozy_navy_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="1" />

                    <TextView
                        android:id="@+id/tv_stat_3_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/cozy_subtext"
                        android:textSize="11sp"
                        tools:text="Hints" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mascot Speech Bubble (Compact to preserve space for buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_speech_bubble"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/img_puzzle_cute_cat" />

                <TextView
                    android:id="@+id/tv_complete_speech"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/dialog_complete_speech"
                    android:textColor="@color/cozy_navy_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Next Level Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_complete_next"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/cozy_pastel_pink"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_btn_next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius_pill" />

            <!-- Back to Levels Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_complete_back_levels"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/cozy_pastel_blue"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dialog_btn_back_levels"
                android:textAllCaps="false"
                android:textColor="@color/cozy_navy_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/button_corner_radius_pill" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Top Peeking Cat Mascot -->
    <ImageView
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/img_puzzle_cute_cat" />

</FrameLayout>
