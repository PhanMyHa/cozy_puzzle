<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_large"
    app:cardBackgroundColor="@color/cozy_card_background"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_soft"
    app:strokeColor="@color/cozy_card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_xlarge"
        android:paddingBottom="@dimen/spacing_large">

        <!-- Title with Sparkles -->
        <TextView
            android:id="@+id/tv_unlock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cat_unlock_dialog_title"
            android:textColor="@color/cozy_navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Mascot Illustration -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="@dimen/spacing_medium">

            <ImageView
                android:id="@+id/iv_unlocked_cat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                tools:src="@drawable/img_cat_pudding" />

        </FrameLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/cat_unlock_dialog_subtitle"
            android:textColor="@color/cozy_subtext"
            android:textSize="13sp" />

        <!-- Cat Name -->
        <TextView
            android:id="@+id/tv_unlocked_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cozy_navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Pudding" />

        <!-- Rarity Badge -->
        <TextView
            android:id="@+id/tv_unlocked_rarity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_currency_pill"
            android:backgroundTint="@color/cozy_rarity_rare_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="@color/cozy_rarity_rare"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Rare" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_unlocked_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/cozy_subtext"
            android:textSize="13sp"
            tools:text="Pudding is a curious cat who loves exploring new magical places!" />

        <!-- Unlock Condition Recap Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/cozy_pastel_blue_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cozy_pastel_blue_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_unlock_how_to_unlock"
                    android:textColor="@color/cozy_subtext"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_unlocked_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/cozy_navy_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="⭐ Complete 10 levels" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Got it! Pill Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unlock_got_it"
            style="@style/Widget.CozyPuzzle.Button.Pill.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/cat_unlock_btn_got_it" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
