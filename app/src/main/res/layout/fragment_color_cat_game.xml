<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cozy_bg_screen">

    <!-- Top Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_game_back"
            android:layout_width="@dimen/home_currency_pill_height"
            android:layout_height="@dimen/home_currency_pill_height"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Timer Pill -->
        <LinearLayout
            android:id="@+id/layout_timer_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_game_back"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_timer" />

            <TextView
                android:id="@+id/tv_game_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/cozy_navy_text"
                android:textSize="12sp"
                tools:text="02:45" />
        </LinearLayout>

        <!-- Level Number -->
        <TextView
            android:id="@+id/tv_game_level_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/cozy_navy_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_progress_pill"
            app:layout_constraintStart_toEndOf="@id/layout_timer_pill"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Level 1" />

        <!-- Progress Pill -->
        <LinearLayout
            android:id="@+id/layout_progress_pill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_timer_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_game_pause"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_yellow" />

            <TextView
                android:id="@+id/tv_game_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/cozy_navy_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="3/8" />
        </LinearLayout>

        <!-- Pause Button -->
        <ImageButton
            android:id="@+id/btn_game_pause"
            android:layout_width="@dimen/home_currency_pill_height"
            android:layout_height="@dimen/home_currency_pill_height"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_pause"
            android:src="@drawable/ic_pause_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Canvas Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_coloring_canvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        app:cardBackgroundColor="@color/cozy_card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_large"
        app:cardElevation="@dimen/card_elevation_soft"
        app:layout_constraintBottom_toTopOf="@id/layout_palette_card"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        app:strokeColor="@color/cozy_card_stroke"
        app:strokeWidth="@dimen/card_stroke_width">

        <com.example.cozypuzzle.core.customview.SvgColoringView
            android:id="@+id/svg_coloring_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Palette Swatches Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_palette_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/cozy_card_background"
        app:cardCornerRadius="@dimen/card_corner_radius_medium"
        app:cardElevation="@dimen/card_elevation_subtle"
        app:layout_constraintBottom_toTopOf="@id/layout_tools_bar"
        app:strokeColor="@color/cozy_card_stroke"
        app:strokeWidth="@dimen/card_stroke_width">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_palette"
            android:layout_width="match_parent"
            android:layout_height="@dimen/color_cat_palette_height"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_color_palette" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Tools Bar: Reset, Undo, Hint -->
    <LinearLayout
        android:id="@+id/layout_tools_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Reset Button -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp">

            <ImageButton
                android:id="@+id/btn_tool_reset"
                android:layout_width="@dimen/color_cat_tool_btn_size"
                android:layout_height="@dimen/color_cat_tool_btn_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/color_cat_btn_reset"
                android:src="@drawable/ic_reset" />
        </FrameLayout>

        <!-- Undo Button -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp">

            <ImageButton
                android:id="@+id/btn_tool_undo"
                android:layout_width="@dimen/color_cat_tool_btn_size"
                android:layout_height="@dimen/color_cat_tool_btn_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/color_cat_btn_undo"
                android:src="@drawable/ic_undo" />
        </FrameLayout>

        <!-- Hint Button with Badge -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btn_tool_hint"
                android:layout_width="@dimen/color_cat_tool_btn_size"
                android:layout_height="@dimen/color_cat_tool_btn_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/color_cat_btn_hint"
                android:src="@drawable/ic_lightbulb" />

            <TextView
                android:id="@+id/tv_hint_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_hint_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
