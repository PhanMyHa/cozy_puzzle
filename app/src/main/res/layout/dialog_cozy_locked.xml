<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/cozy_card_background"
    app:cardCornerRadius="@dimen/cat_puzzle_dialog_radius"
    app:cardElevation="6dp"
    app:strokeColor="@color/cozy_card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_piece_tray">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_locked_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.5"
                android:scaleType="centerCrop"
                android:src="@drawable/img_puzzle_cute_cat"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_closed" />
        </FrameLayout>

        <!-- Level Ribbon / Title -->
        <TextView
            android:id="@+id/tv_locked_level_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tab_pill_selected"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Level 2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lightbulb" />

            <TextView
                android:id="@+id/tv_locked_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/dialog_locked_message"
                android:textColor="@color/cozy_subtext"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss_locked"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_pill"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/cozy_pastel_blue"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dialog_btn_back_levels"
            android:textAllCaps="false"
            android:textColor="@color/cozy_navy_text"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:cornerRadius="@dimen/button_corner_radius_pill" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
