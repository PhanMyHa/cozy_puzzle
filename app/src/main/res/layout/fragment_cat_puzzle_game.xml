<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_sky">

    <!-- Top Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_game_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/home_header_padding_horizontal"
        android:paddingTop="@dimen/home_header_padding_top"
        android:paddingEnd="@dimen/home_header_padding_horizontal"
        android:paddingBottom="@dimen/spacing_small"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/home_avatar_size"
            android:layout_height="@dimen/home_avatar_size"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_level_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cozy_navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_progress_badge"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Level 5" />

        <!-- Star Progress Badge -->
        <LinearLayout
            android:id="@+id/layout_progress_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_currency_pill_height"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/bg_currency_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_pause_header"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/home_currency_icon_size"
                android:layout_height="@dimen/home_currency_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_yellow" />

            <TextView
                android:id="@+id/tv_star_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_tiny"
                android:textColor="@color/cozy_navy_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="3/3" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_pause_header"
            android:layout_width="@dimen/home_avatar_size"
            android:layout_height="@dimen/home_avatar_size"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cat_puzzle_btn_pause"
            android:src="@drawable/ic_pause_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/cozy_pastel_blue_dark" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Timer Pill -->
    <LinearLayout
        android:id="@+id/layout_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:background="@drawable/bg_timer_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:paddingVertical="@dimen/spacing_tiny"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_game_header">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_timer" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_tiny"
            android:textColor="@color/cozy_navy_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="02:35" />

    </LinearLayout>

    <!-- 3x3 Puzzle Board View -->
    <com.example.cozypuzzle.core.customview.CatPuzzleBoardView
        android:id="@+id/puzzle_board"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/cat_puzzle_board_margin_top"
        app:layout_constraintBottom_toTopOf="@id/layout_tray_container"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_timer"
        app:layout_constraintWidth_max="@dimen/cat_puzzle_board_max_size" />

    <!-- Piece Tray Container -->
    <FrameLayout
        android:id="@+id/layout_tray_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cat_puzzle_tray_height"
        android:layout_marginHorizontal="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_piece_tray"
        android:paddingHorizontal="@dimen/spacing_small"
        android:paddingVertical="@dimen/spacing_tiny"
        app:layout_constraintBottom_toTopOf="@id/layout_actions"
        app:layout_constraintTop_toBottomOf="@id/puzzle_board">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tray_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_cat_puzzle_piece" />

    </FrameLayout>

    <!-- Bottom Actions Row (Hint, Shuffle, Pause) -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_large"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Hint Button (Secondary Blue Pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hint"
            style="@style/Widget.CozyPuzzle.Button.Pill.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/cat_puzzle_btn_hint"
            app:icon="@drawable/ic_lightbulb"
            app:iconGravity="textStart"
            app:iconSize="@dimen/cat_puzzle_button_icon_size" />

        <!-- Shuffle Button (Secondary Blue Pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_shuffle"
            style="@style/Widget.CozyPuzzle.Button.Pill.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/cat_puzzle_btn_shuffle"
            app:icon="@drawable/ic_shuffle"
            app:iconGravity="textStart"
            app:iconSize="@dimen/cat_puzzle_button_icon_size" />

        <!-- Pause Button (Primary Pink Pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pause_bottom"
            style="@style/Widget.CozyPuzzle.Button.Pill.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cat_puzzle_btn_pause"
            app:icon="@drawable/ic_pause_small"
            app:iconGravity="textStart"
            app:iconSize="@dimen/cat_puzzle_button_icon_size" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
