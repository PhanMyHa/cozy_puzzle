<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cozy_bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xxlarge">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/layout_coins_pill"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_daily_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/daily_tasks_title"
                    android:textColor="@color/cozy_navy_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_daily_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_tasks_subtitle"
                    android:textColor="@color/cozy_subtext"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Coin Balance Pill -->
            <LinearLayout
                android:id="@+id/layout_coins_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_currency_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_yellow" />

                <TextView
                    android:id="@+id/tv_player_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/cozy_navy_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="300" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Daily Streak Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_daily_streak"
            style="@style/Widget.CozyPuzzle.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <!-- Streak Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_streak_flame" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/daily_tasks_streak_title"
                        android:textColor="@color/cozy_navy_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFA726"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="3 Days Streak! 🔥" />

                </LinearLayout>

                <!-- Streak Subtitle Message -->
                <TextView
                    android:id="@+id/tv_streak_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/daily_tasks_streak_today_todo"
                    android:textColor="@color/cozy_subtext"
                    android:textSize="12sp" />

                <!-- 7-Day Row -->
                <LinearLayout
                    android:id="@+id/layout_week_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <!-- Day 1: Mon -->
                    <LinearLayout
                        android:id="@+id/day_container_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mon"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_1"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_1"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tv_day_num_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="1" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 2: Tue -->
                    <LinearLayout
                        android:id="@+id/day_container_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tue"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_2"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_2"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="2" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 3: Wed -->
                    <LinearLayout
                        android:id="@+id/day_container_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wed"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_3"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_3"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="3" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 4: Thu -->
                    <LinearLayout
                        android:id="@+id/day_container_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thu"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_4"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_4"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="4" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 5: Fri -->
                    <LinearLayout
                        android:id="@+id/day_container_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fri"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_5"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_5"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="5" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 6: Sat -->
                    <LinearLayout
                        android:id="@+id/day_container_6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sat"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_6"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_6"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="6" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Day 7: Sun -->
                    <LinearLayout
                        android:id="@+id/day_container_7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_name_7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sun"
                            android:textColor="@color/cozy_subtext"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/fl_day_circle_7"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_day_item_normal">

                            <ImageView
                                android:id="@+id/iv_day_check_7"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_day_num_7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/cozy_navy_text"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="7" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Bonus Featured Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_daily_bonus"
            style="@style/Widget.CozyPuzzle.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/cozy_pastel_pink_light"
            app:strokeColor="@color/cozy_pastel_pink">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_medium">

                <!-- Gift Box Icon -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gift_box" />

                <!-- Bonus Description -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/daily_tasks_bonus_title"
                        android:textColor="@color/cozy_navy_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Bonus Coins Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_yellow" />

                        <TextView
                            android:id="@+id/tv_bonus_coins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/cozy_pastel_pink_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="+100 Coins" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/daily_tasks_bonus_desc"
                        android:textColor="@color/cozy_subtext"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Claim Bonus Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_claim_bonus"
                    style="@style/Widget.CozyPuzzle.Button.Pill.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:textSize="12sp"
                    tools:text="Claim Bonus 🎁" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Missions Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_paw" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Daily Missions"
                android:textColor="@color/cozy_navy_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_missions_progress_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cozy_subtext"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2/5 Completed" />

        </LinearLayout>

        <!-- Missions RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_daily_missions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="5"
            tools:listitem="@layout/item_daily_mission" />

        <!-- Mascot Cute Footer -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_large"
            android:contentDescription="@null"
            android:src="@drawable/img_puzzle_cute_cat" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
