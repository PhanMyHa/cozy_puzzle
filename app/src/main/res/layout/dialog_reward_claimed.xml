<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_large"
    app:cardBackgroundColor="@color/cozy_card_background"
    app:cardCornerRadius="@dimen/card_corner_radius_large"
    app:cardElevation="@dimen/card_elevation_soft"
    app:strokeColor="@color/cozy_card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_xlarge"
        android:paddingBottom="@dimen/spacing_large">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_reward_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/daily_reward_dialog_title"
            android:textColor="@color/cozy_navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Celebration Icon / Mascot -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_medium">

            <ImageView
                android:id="@+id/iv_reward_icon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/img_puzzle_cute_cat" />

        </FrameLayout>

        <!-- Reward Amount Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_currency_pill"
            android:backgroundTint="@color/cozy_pastel_pink_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_yellow" />

            <TextView
                android:id="@+id/tv_reward_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/cozy_pastel_pink_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="+40 Coins" />

        </LinearLayout>

        <!-- Subtitle message -->
        <TextView
            android:id="@+id/tv_reward_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:gravity="center"
            android:text="@string/daily_reward_dialog_subtitle"
            android:textColor="@color/cozy_subtext"
            android:textSize="14sp" />

        <!-- Collect! Pill Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reward_collect"
            style="@style/Widget.CozyPuzzle.Button.Pill.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/daily_reward_dialog_btn_collect" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
